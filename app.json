{
  "expo": {
    "name": "Pearl Delivery",
    "slug": "pearl-delivery",
    "scheme": "pearldelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7D2EFF"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1003",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position est utilisée pour optimiser vos livraisons en temps réel.",
        "NSCameraUsageDescription": "La caméra est utilisée pour la preuve de livraison.",
        "NSPhotoLibraryAddUsageDescription": "Enregistrement des preuves de livraison dans la galerie.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.pearlstreets.delivery",
      "buildNumber": "1002"
    },
    "android": {
      "package": "com.pearlstreets.delivery",
      "versionCode": 1002,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7D2EFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-notifications",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "./plugins/withFmtConstevalFix"
    ],
    "extra": {
      "oneSignalAppId": "0c4d0c76-eedd-426a-9d48-156cc6f879c7",
      "eas": {
        "projectId": "3be79991-dd51-479d-8ff7-d6c45a1af111"
      }
    },
    "owner": "localidad"
  }
}