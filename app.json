{
  "expo": {
    "name": "Pearl Delivery",
    "slug": "pearl-delivery",
    "scheme": "pearldelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position est utilisée pour optimiser vos livraisons en temps réel.",
        "NSCameraUsageDescription": "La caméra est utilisée pour la preuve de livraison.",
        "NSPhotoLibraryAddUsageDescription": "Enregistrement des preuves de livraison dans la galerie.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.pearlstreets.delivery"
    },
    "android": {
      "package": "com.pearlstreets.delivery",
      "jsEngine": "hermes",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-notifications"
    ],
    "owner": "localidad",
    "extra": {
      "oneSignalAppId": "",
      "eas": {
        "projectId": "3be79991-dd51-479d-8ff7-d6c45a1af111"
      }
    }
  }
}
