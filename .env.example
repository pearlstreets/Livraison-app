# Copy to `.env` at the project root; Expo reads EXPO_PUBLIC_* vars at build time.
# Source of truth for backend host: Marketplace ALLOWED_HOSTS (Shubhras/Marketplace-082024-001).

# Production (Pearl Streets prod API)
# EXPO_PUBLIC_API_URL=https://api.pearlstreets.com

# Staging / dev
# EXPO_PUBLIC_API_URL=https://pythonapi.digiexports.in

# Local (Django runserver on the same LAN as your device)
# EXPO_PUBLIC_API_URL=http://192.168.1.15:8000

# If unset, the app falls back to https://pythonapi.digiexports.in
EXPO_PUBLIC_API_URL=https://pythonapi.digiexports.in
