{
  "expo": {
    "name": "Pearl Delivery",
    "slug": "pearl-delivery",
    "scheme": "pearldelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position est utilisée pour optimiser vos livraisons en temps réel.",
        "NSCameraUsageDescription": "La caméra est utilisée pour la preuve de livraison.",
        "NSPhotoLibraryAddUsageDescription": "Enregistrement des preuves de livraison dans la galerie.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "api.pearlstreets.com": {
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSExceptionRequiresForwardSecrecy": true,
              "NSIncludesSubdomains": false
            }
          }
        }
      },
      "bundleIdentifier": "com.pearlstreets.delivery",
      "buildNumber": "3",
      "appleTeamId": "5R8LA6469V"
    },
    "android": {
      "package": "com.pearlstreets.delivery",
      "jsEngine": "hermes",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "usesCleartextTraffic": false
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-notifications",
      "sentry-expo",
      "@sentry/react-native"
    ]
  }
}
